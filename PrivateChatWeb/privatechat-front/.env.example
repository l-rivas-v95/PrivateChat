# Servidor al que se conecta el WebSocket.
#
# En desarrollo, si lo dejas vacío se usa ws://localhost:8080 automáticamente.
# Solo hace falta tocarlo si tu servidor está en otra máquina o en otro puerto:
#   VITE_CHAT_SERVER_URL=ws://192.168.1.45:8080
#
# En producción déjalo vacío: el front usará el mismo origen desde el que se
# haya cargado (wss://tu-dominio/chat).
VITE_CHAT_SERVER_URL=

# Destino al que Vite reenvía /upload y /file en desarrollo.
# Debe apuntar al mismo servidor que la línea de arriba, pero en http://.
VITE_DEV_PROXY_TARGET=http://localhost:8080
