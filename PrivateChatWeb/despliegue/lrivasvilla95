server {
    listen 80;
    server_name lrivasvilla95.duckdns.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name lrivasvilla95.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/lrivasvilla95.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lrivasvilla95.duckdns.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Raiz por defecto para lo que se sirve como fichero estatico.
    # Las locations que necesitan otra la sobrescriben.
    root /var/www;

    # ---------------------------------------------------------------- SwapCloset

    location /api/ {
        proxy_pass http://localhost:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 60s;
    }

    location /swapcloset/ {
        proxy_pass http://localhost:4200/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /apk/ {
        proxy_pass http://localhost:4200/apk/;
        proxy_set_header Host $host;
    }

    # ----------------------------------------------------------------- Portfolio

    location /static/ {
        alias /var/www/portfolio/static/;
        expires 7d;
    }

    location = / {
        root /var/www/portfolio;
        try_files /index.html =404;
    }

    # --------------------------------------------------- PrivateChat: API y APK

    location /chat {
        proxy_pass http://localhost:8082/chat;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location /upload {
        proxy_pass http://localhost:8082/upload;
        proxy_set_header Host $host;
        client_max_body_size 10M;
    }

    location /file/ {
        proxy_pass http://localhost:8082/file/;
        proxy_set_header Host $host;
    }

    location /privatechat/apk {
        proxy_pass http://localhost:8082/privatechat/apk;
        proxy_set_header Host $host;
        client_max_body_size 100M;
    }

    # ------------------------------------------------------- PrivateChat: la web

    location = /privatechat {
        return 301 /privatechat/;
    }

    location /privatechat/assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /privatechat/index.html {
        add_header Cache-Control "no-cache";
    }

    location = /privatechat/sw.js {
        add_header Cache-Control "no-cache";
    }

    location = /privatechat/manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    location /privatechat/ {
        try_files $uri $uri/ /privatechat/index.html;
    }
}
